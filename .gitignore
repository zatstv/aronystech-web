# La llave de Gemini nunca va acá. Vive en ~/.config/aronystech/gemini.key
*.key
.env

# Node y la compilación
node_modules/
dist/
*.log

# Material de trabajo pesado: las fotos crudas y los videos no van al repo.
# Lo que la página usa vive en public/img y public/video.
fotos/
*.zip

# El material crudo que se arrastra acá para convertirlo: fotos sin comprimir,
# capturas, videos de los que sale el de la portada. La versión que usa la
# página queda en public/ ya liviana; esto se queda en tu disco.
/crudos/

# Ningún video crudo entra al repo: el de la portada venía de 5,9 MB y ahí
# quedaría para siempre. La versión comprimida que usa la página sí se sube,
# por eso la excepción.
*.mp4
!public/video/*.mp4

# Copias de la etapa anterior: las fotos y modelos que usa la página ahora viven
# en public/, y la carpeta que se publica la genera `npm run build` en dist/.
# Los archivos siguen en tu disco, solo no se suben al repo.
/img/
/modelo/
/publicar/

# Las fotos que llegan para la rueda. Las que usa la página, ya livianas y
# con nombre, están en public/img/rueda.
/fotos pagina aronys tech/
